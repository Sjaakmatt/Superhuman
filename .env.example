# Supabase — zonder deze twee draait de app, maar leest hij het plan uit
# supabase/seed en kun je niets loggen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side: seed-script, cron-routes en de Strava-sync.
SUPABASE_SERVICE_ROLE_KEY=

# Strava — eigen OAuth-app op strava.com/settings/api,
# scope activity:read_all,profile:read_all
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic — voor de analyses.
ANTHROPIC_API_KEY=

# Beschermt de cron-routes. worker.ts stuurt hem mee als Authorization: Bearer <waarde>.
# In productie een Worker-secret: npx wrangler secret put CRON_SECRET
CRON_SECRET=

# Web push voor de ochtendmelding. Sleutels maken:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@voorbeeld.nl

# Basis-URL van de app, voor de Strava-callback en de crons.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# In productie ligt dit anders. NEXT_PUBLIC_* wordt bij de build ingebakken en
# staat daarom als repo-Variable in GitHub Actions; de rest zijn Worker-secrets:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# Zie README, "Deploy — Cloudflare Workers".
